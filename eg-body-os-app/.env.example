# PostgreSQL — local docker-compose default
DATABASE_URL="postgresql://eg:eg@localhost:5432/eg_body_os"

# Better Auth — openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-32-plus-chars-of-high-entropy"
BETTER_AUTH_URL="http://localhost:3000"

# Comma-separated allowlist. Same OTP as users. 2FA/passkey is later.
ADMIN_EMAIL="you@example.com"

# Optional. If unset, DevEmailProvider logs the OTP (and stores it for /api/dev/otp in development).
RESEND_API_KEY=""
RESEND_FROM="Атмосфера 3D <noreply@example.com>"
