# Telegram
TELEGRAM_BOT_TOKEN=

# OpenAI — черновики канала (не ответы в клубе)
OPENAI_API_KEY=

# Kie.ai — изображения 4K и будущая генерация видео
KIE_API_KEY=

# Закрытый клуб (invite/kick) — ID вида -100...
COMMUNITY_CHAT_ID=

# Публичный канал (бот должен быть админом — иначе проверка подписки не работает)
CHANNEL_ID=@EvgeniiGoshev

# 1 = тренировка/уровни только после подписки на канал; 0 = отключить gate
REQUIRE_CHANNEL_SUB=1

# Админы для уведомлений (через запятую)
ADMIN_TELEGRAM_IDS=

# Как узнать свой ID (не путать с @username):
# 1) Откройте Telegram → найдите бота @userinfobot
# 2) Нажмите Start
# 3) Он пришлёт цифру вида 123456789 — это и есть ваш ID
# 4) Вставьте сюда: ADMIN_TELEGRAM_IDS=123456789
# Зачем: бот понимает, что вы админ (уведомления, approve постов)

# Сайт
SITE_URL=https://egoshev.ru/baza
ONLINE_CLUB_URL=https://eg.egoshev.ru/club

# Telegram Mini App (HTTPS) — Menu Button + /menu
MINI_APP_URL=https://eg.egoshev.ru/app

# Telegram-канал → стена VK. По умолчанию выключено.
# Включать только после получения и проверки VK-токена.
VK_BRIDGE_ENABLED=0
# Для фото нужен пользовательский VK-токен администратора с правами wall + photos.
# Токен сообщества публикует текст, но загрузка wall-фото может вернуть VK error 27.
# COMMUNITY_CHAT_ID=-100xxxxxxxxxx
# VK_ACCESS_TOKEN=
# Опционально: user-токен админа для video.save / shortVideo (клипы). Без него VIDEO/CLIPS не взлетят.
# VK_USER_ACCESS_TOKEN=
VK_GROUP_ID=230430425
VK_API_VERSION=5.199
VK_ALBUM_SETTLE_SECONDS=3
# VK_BRIDGE_DB_PATH=/opt/atmosfera-bot/data/vk_bridge.sqlite3
# Медиа-флаги (текст/фото стены работают при VK_BRIDGE_ENABLED=1 без них):
VK_BRIDGE_VIDEO=0
VK_BRIDGE_CLIPS=0
VK_BRIDGE_STORIES=0
# Соавтор в тексте поста (официального API «соавтор клипа» нет). Личная страница EG: egoshev1
# VK_COAUTHOR_USER_ID=424816541
# VK_COAUTHOR_SCREEN_NAME=egoshev1
# VK_COAUTHOR_LABEL=Евгений Гошев

# Соцсети: ручная публикация постов блога (publish_blog_social.py)
# BLOG_JSON_PATH=/var/www/egoshev.ru/data/blog.json
# SITE_BLOG_BASE=https://eg.egoshev.ru/blog
# SITE_URL_PUBLIC=https://eg.egoshev.ru

# Prodamus — REQUIRED for payment webhooks (fail-closed without it).
# Secret key from Prodamus payment page settings. Never commit the real value.
# Without PRODAMUS_SECRET, signed payment notifications are rejected (503) — no invite.
PRODAMUS_SECRET=
WEBHOOK_BASE_URL=https://bot.egoshev.ru

# Опционально
GOOGLE_SHEETS_WEBHOOK_URL=
NEW_MEMBER_TEST_LINK=
