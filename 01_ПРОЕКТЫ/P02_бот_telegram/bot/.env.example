# Telegram
TELEGRAM_BOT_TOKEN=

# OpenAI — черновики канала (не ответы в клубе)
OPENAI_API_KEY=

# Kie.ai — изображения 4K и будущая генерация видео
KIE_API_KEY=

# Закрытый клуб (invite/kick) — ID вида -100...
COMMUNITY_CHAT_ID=

# Публичный канал (бот должен быть админом — иначе проверка подписки не работает)
CHANNEL_ID=@EvgeniiGoshev

# 1 = гайд/уровни только после подписки на канал; 0 = отключить gate
REQUIRE_CHANNEL_SUB=1

# Админы для уведомлений (через запятую)
ADMIN_TELEGRAM_IDS=

# Как узнать свой ID (не путать с @username):
# 1) Откройте Telegram → найдите бота @userinfobot
# 2) Нажмите Start
# 3) Он пришлёт цифру вида 123456789 — это и есть ваш ID
# 4) Вставьте сюда: ADMIN_TELEGRAM_IDS=123456789
# Зачем: бот понимает, что вы админ (уведомления, approve постов)

# Сайт
SITE_URL=https://egoshev.ru/baza
ONLINE_CLUB_URL=https://eg.egoshev.ru/club

# Telegram Mini App (HTTPS) — Menu Button + /menu
MINI_APP_URL=https://eg.egoshev.ru/app

# Telegram-канал → стена VK. По умолчанию выключено.
# Включать только после получения и проверки VK-токена.
VK_BRIDGE_ENABLED=0
# Для фото нужен пользовательский VK-токен администратора с правами wall + photos.
# Токен сообщества публикует текст, но загрузка wall-фото может вернуть VK error 27.
# COMMUNITY_CHAT_ID=-100xxxxxxxxxx
# VK_ACCESS_TOKEN=
VK_GROUP_ID=230430425
VK_API_VERSION=5.199
VK_ALBUM_SETTLE_SECONDS=3
# VK_BRIDGE_DB_PATH=/opt/atmosfera-bot/data/vk_bridge.sqlite3

