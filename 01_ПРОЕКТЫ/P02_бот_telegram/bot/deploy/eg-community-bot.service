[Unit]
Description=EG Atmosfera Telegram bot (sales + channel)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/atmosfera-bot
EnvironmentFile=/opt/atmosfera-bot/.env
ExecStart=/opt/atmosfera-bot/venv/bin/python bot.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
