# Пример — заполни и сохрани как .env (файл .env в gitignore)

# Хостинг
HOSTING=beget

# SSH (если используешь)
SERVER_HOST=
SERVER_USER=
SERVER_PORT=22
SERVER_PATH=/home/USER/eg.egoshev.ru/public_html

# FTP/SFTP (альтернатива SSH)
FTP_HOST=
FTP_USER=
FTP_PATH=

# Сайт
SITE_STAGING=https://eg.egoshev.ru
SITE_PRODUCTION=https://egoshev.ru

# НЕ ЗАПОЛНЯЙ ПАРОЛИ В ЭТОМ ФАЙЛЕ В ЧАТЕ — только локально на Mac
