# Server-side only. Never expose these as NEXT_PUBLIC_*.

# Required for /admin — if empty, login is denied (fail-closed, no default password).
ADMIN_PASSWORD=

# Optional dedicated session HMAC secret. Falls back to ADMIN_PASSWORD if empty.
# Prefer a long random value separate from the login password.
ADMIN_SECRET=

# Contact form → Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional
KIE_API_KEY=
NEXT_PUBLIC_SITE_URL=https://eg.egoshev.ru
