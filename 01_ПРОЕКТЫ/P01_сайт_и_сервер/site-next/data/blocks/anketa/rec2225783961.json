ant;background:var(--surf2)!important;box-shadow:0 0 0 1px var(--silvb),0 8px 32px -8px var(--glow),inset 0 1px 0 rgba(255,255,255,0.1)}\n.rcd.ck::before{opacity:1}\n.rcd.ck::after{content:'\\2713';position:absolute;top:14px;right:14px;width:22px;height:22px;background:var(--gs);color:var(--bg);border-radius:50%;font-size:13px;font-weight:700;display:flex;align-items:center;justify-content:center;box-shadow:0 0 12px var(--glow);animation:si 0.3s}\n@keyframes si{from{transform:scale(0);opacity:0}to{transform:scale(1);opacity:1}}\n.rct{font-size:15px;font-weight:600;color:var(--text)!important;position:relative;z-index:1}\n.rcd.ck .rct{color:var(--silvb)!important}\n.rcds{font-size:12px;color:var(--mute)!important;line-height:1.5;position:relative;z-index:1}\n.cp{display:flex;flex-wrap:wrap;gap:8px}\n.pl{display:inline-flex;align-items:center;gap:8px;background:var(--surf)!important;border:1px solid var(--bordb)!important;border-radius:100px;padding:10px 18px;cursor:pointer;transition:all 0.25s;font-size:13px;color:var(--soft)!important;user-select:none;position:relative;overflow:hidden}\n.pl::before{content:'';position:absolute;inset:0;background:var(--gss);opacity:0;transition:opacity 0.3s;pointer-events:none}\n.pl:hover{border-color:var(--line)!important;color:var(--text)!important;transform:translateY(-1px)}\n.pl:hover::before{opacity:0.6}\n.pl input{display:none}\n.pl.ck{background:var(--surf2)!important;border-color:var(--silvb)!important;color:var(--silvb)!important;box-shadow:0 0 0 1px var(--line),0 4px 16px -4px var(--glow),inset 0 1px 0 rgba(255,255,255,0.1);font-weight:600}\n.pl.ck::before{opacity:1}\n.pmw{background:linear-gradient(180deg,var(--surf) 0%,var(--bg2) 100%);border:1px solid var(--bordb);border-radius:var(--r2);padding:28px 24px;margin-bottom:16px;box-shadow:0 10px 40px -20px rgba(0,0,0,0.6)}\n.pmt{font-size:12px;color:var(--mute)!important;margin-bottom:24px;text-align:center;letter-spacing:0.18em;text-transform:uppercase;font-weight:600}\n.bs