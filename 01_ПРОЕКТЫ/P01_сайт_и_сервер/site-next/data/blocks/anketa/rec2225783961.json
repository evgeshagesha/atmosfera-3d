,221,228,0.15);transition:transform 0.2s}\n.rr input[type=range]::-webkit-slider-thumb:hover{transform:scale(1.15)}\n.rr input[type=range]::-moz-range-thumb{width:22px;height:22px;background:var(--silvb);border:2px solid var(--silvb);border-radius:50%;cursor:pointer;box-shadow:0 4px 16px var(--glow)}\n.rv{min-width:64px;text-align:center;font-family:'Magistral',sans-serif!important;font-size:30px;font-weight:800;background:var(--gs);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}\n.rl{display:flex;justify-content:space-between;font-size:11px;color:var(--mute)!important;margin-top:12px;padding:0 4px}\n.lb{background:linear-gradient(180deg,var(--bg2) 0%,var(--surf) 100%);border:1px solid var(--bordb);border-radius:var(--r2);padding:28px 32px;margin-bottom:36px}\n.lb h4{font-family:'Velo Sans',sans-serif!important;font-size:22px;color:var(--silvb)!important;margin-bottom:16px;font-weight:700;font-style:italic}\n.lb p{font-size:13px;color:var(--soft)!important;margin-bottom:14px;line-height:1.65}\n.lb a{color:var(--silvb)!important;text-decoration:none;border-bottom:1px dashed var(--line);transition:all 0.2s}\n.lb a:hover{border-bottom-style:solid;text-shadow:0 0 8px var(--glow)}\n.lc{display:flex;align-items:flex-start;gap:14px;padding:12px 0;cursor:pointer;user-select:none}\n.lc input[type=checkbox]{margin-top:4px;width:20px;height:20px;accent-color:var(--silvb);cursor:pointer;flex-shrink:0}\n.lc span{font-size:13px;color:var(--soft)!important;line-height:1.6}\n.subs{background:radial-gradient(ellipse at top,rgba(216,221,228,0.12) 0%,transparent 60%),linear-gradient(180deg,var(--bg2) 0%,var(--surf) 100%);border:1px solid var(--line);border-radius:var(--r3);padding:48px 36px;text-align:center;margin-top:48px;box-shadow:0 0 80px -30px var(--glow);position:relative;overflow:hidden}\n.subs::before{content:'';position:absolute;top:0;left:50%;transform:translateX(-50%);width:70%;height:1px;background:linear-gradient(90deg,transparent,var(--silvb),transparent);opacity:0.7}\n.subs h3{font-family:'Magistral',sans-serif!important;font-size:32px;font-weight:800;margin-bottom:14px;color:var(--text)!important;text-transform:uppercase;background:var(--gs);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}\n.subs h3 em{font-style:normal!important;color:var(--silvb)!important}\n.subd{color:var(--soft)!important;font-size:14px;margin-bottom:28px!important;max-width:520px;margin-left:auto;margin-right:auto;line-height:1.65}\n.sb{display:flex;gap:14px;justify-content:center;flex-wrap:wrap;margin-bottom:24px}\n.bp{display:inline-flex;align-items:center;justify-content:center;gap:10px;background:var(--gs)!important;color:var(--bg)!important;font-family:'Manrope',sans-serif!important;font-size:13px;font-weight:800;letter-spacing:0.14em;text-transform:uppercase;padding:18px 36px;border-radius:100px;border:none;cursor:pointer;transition:all 0.3s;box-shadow:0 0 32px var(--glow);position:relative;overflow:hidden;text-decoration:none}\n.bp::before{content:'';position:absolute;top:0;left:-100%;width:100%;height:100%;background:linear-gradient(90deg,transparent,rgba(255,255,255,0.5),transparent);transition:left 0.6s}\n.bp:hover::before{left:100%}\n.bp:hover{transform:translateY(-3px);box-shadow:0 0 48px var(--glow),0 16px 40px -8px rgba(216,221,228,0.5)}\n.bp:disabled{opacity:0.6;cursor:not-allowed;transform:none}\n.bsec{display:inline-flex;align-items:center;justify-content:center;gap:10px;background:transparent!important;color:var(--soft)!important;font-family:'Manrope',sans-serif!important;font-size:13px;font-weight:600;letter-spacing:0.06em;padding:18px 32px;border-radius:100px;border:1px solid var(--bords)!important;cursor:pointer;transition:all 0.25s}\n.bsec:hover{border-color:var(--silvb)!important;color:var(--silvb)!important;background:var(--soft2)!important}\n.sf{margin-top:4px;padding:18px 22px;background:var(--surf);border:1px solid var(--bordb);border-radius:var(--r);font-size:13px;color:var(--soft);line-height:1.6;max-width:560px;margin-left:auto;margin-right:auto;text-align:left}\n.sf strong{color:var(--silvb);font-weight:600}\n.ac{display:flex;gap:10px;flex-wrap:wrap;justify-content:center;margin-top:14px}\n.acl{display:inline-flex;align-items:center;gap:6px;padding:8px 14px;background:var(--surf2);border:1px solid var(--bordb);border-radius:100px;color:var(--soft)!important;text-decoration:none!important;font-size:12px;font-weight:500;transition:all 0.2s}\n.acl:hover{border-color:var(--line);color:var(--silvb)!important;transform:translateY(-1px)}\n.sm{display:none;font-size:14px;margin-top:24px;padding:16px 22px;border-radius:var(--r);text-align:left;line-height:1.5}\n.sm.vs{display:block;animation:fu 0.5s}\n.sm.suc{color:var(--green);background:rgba(110,231,167,0.06);border:1px solid rgba(110,231,167,0.25)}\n.sm.inf{color:var(--silvb);background:var(--soft2);border:1px solid var(--line)}\n.sm a{color:var(--silvb)!important;font-weight:600;text-decoration:underline}\n.ftr{text-align:center;padding:36px 20px;border-top:1px solid var(--bord);color:var(--mute)!important;font-size:12px;background:transparent!important}\n.ftr a{color:var(--silvb)!important;text-decoration:none}\n@media(max-width:600px){.r2{grid-template-columns:1fr}.rc{grid-template-columns:1fr}.cnt{padding:32px 18px 100px!important}.hdr{padding:14px 18px}.hdr-b{font-size:17px}.pb{top:53px}.iq{padding:24px 22px}.iq p{font-size:17px}.sn{font-size:50px}.st{font-size:24px}.sh{gap:16px}.subs{padding:36px 22px}.subs h3{font-size:24px}.sb{flex-direction:column}.sb .bp,.sb .bsec{width:100%}.bs{width:145px;height:340px}.bsw{gap:16px}.pmw{padding:22px 14px}}\n</style></head> <body> <div class=\"atm3d\"> <div class=\"hdr\"><div class=\"hdr-b\">АТМОСФЕРА 3D</div><div class=\"hdr-t\">Анкета клиента</div></div> <div class=\"pb\"><div class=\"pbf\" id=\"pbf\"></div></div> <div class=\"cnt\"> <div class=\"hero\"> <div class=\"hbt\">АТМОСФЕРА 3D</div> <div class=\"hbs\">Движение · Дыхание · Дисциплина</div> <div class=\"htag\">Анкета перед началом работы</div> <p class=\"hl\">Эта анкета — основа моей подготовки к работе с вами. Чем подробнее ваши ответы, тем точнее будет диагностика и индивидуальный план. Заполнение займёт 10–15 минут.</p> <div class=\"hm\"><div class=\"hmi\">10 разделов</div><div class=\"hmi\">~12 минут</div><div class=\"hmi\">Конфиденциально</div></div> </div> <div class=\"iq\"><p>«Я работаю с телом как с системой. Чтобы её увидеть целостно, мне нужна полная картина — где живёт боль, как вы дышите, как двигаетесь, что уже пробовали. Поэтому прошу отнестись к анкете внимательно: она часть нашей работы.»</p><div class=\"au\">— Евгений Гошев</div></div> <form id=\"bf\" autocomplete=\"on\" onsubmit=\"return false\"> <input type=\"hidden\" name=\"БРИФ_ПОЛНЫЙ\" id=\"bft\" value=\"\"> <input type=\"hidden\" name=\"Карта_тела\" id=\"pzf\" value=\"\"> <div class=\"sec\"><div class=\"sh\"><div class=\"sn\">01</div><div class=\"stw\"><div class=\"st\">Знакомство</div><div class=\"ss\">Контакты и удобный канал связи</div></div></div><div class=\"sd\"></div> <div class=\"f\"><label class=\"fl\">Как вас зовут (имя и фамилия) <span class=\"req\">*</span></label><input type=\"text\" id=\"name\" name=\"Name\" placeholder=\"Иван Иванов\"></div> <div class=\"r2\"><div class=\"f\"><label class=\"fl\">Возраст <span class=\"req\">*</span></label><input type=\"number\" id=\"age\" name=\"Возраст\" min=\"14\" max=\"100\" placeholder=\"35\"></div><div class=\"f\"><label class=\"fl\">Город <span class=\"req\">*</span></label><input type=\"text\" id=\"city\" name=\"Город\" placeholder=\"Москва\"></div></div> <div class=\"r2\"><div class=\"f\"><label class=\"fl\">Рост, см</label><input type=\"number\" id=\"height\" name=\"Рост\" min=\"120\" max=\"230\" placeholder=\"178\"></div><div class=\"f\"><label class=\"fl\">Вес, кг</label><input type=\"number\" id=\"weight\" name=\"Вес\" min=\"35\" max=\"250\" placeholder=\"74\"></div></div> <div class=\"f\"><label class=\"fl\">Телефон <span class=\"req\">*</span></label><input type=\"tel\" id=\"phone\" name=\"Phone\" placeholder=\"+7 (___) ___-__-__\"></div> <div class=\"f\"><label class=\"fl\">Email</label><input type=\"email\" id=\"email\" name=\"Email\" placeholder=\"вы@example.ru\"></div> <div class=\"f\"><label class=\"fl\">Удобный мессенджер <span class=\"req\">*</span></label><div class=\"cp\"> <label class=\"pl\"><input type=\"checkbox\" data-name=\"msg\" value=\"Telegram\"> Telegram</label> <label class=\"pl\"><input type=\"checkbox\" data-name=\"msg\" value=\"WhatsApp\"> WhatsApp</label> <label class=\"pl\"><input type=\"checkbox\" data-name=\"msg\" value=\"VK\"> VK</label> <label class=\"pl\"><input type=\"checkbox\" data-name=\"msg\" value=\"Max\"> Max</label> <label class=\"pl\"><input type=\"checkbox\" data-name=\"msg\" value=\"Звонок\"> Звонок</label> </div></div></div> <div class=\"sec\"><div class=\"sh\"><div class=\"sn\">02</div><div class=\"stw\"><div class=\"st\">Формат и запрос</div><div class=\"ss\">Какой формат работы и что привело</div></div></div><div class=\"sd\"></div> <div class=\"f\"><label class=\"fl\">Какой формат работы вам интересен <span class=\"req\">*</span></label><div class=\"rc\"> <label class=\"rcd\"><input type=\"radio\" name=\"format\" value=\"Очно — индивидуальная сессия в студии\"><div class=\"rct\">Очно в студии</div><div class=\"rcds\">Индивидуальная сессия, Москва, ул. Вятская</div></label> <label class=\"rcd\"><input type=\"radio\" name=\"format\" value=\"Очно — групповая тренировка\"><div class=\"rct\">Групповая тренировка</div><div class=\"rcds\">До 5 человек в студии</div></label> <label class=\"rcd\"><input type=\"radio\" name=\"format\" value=\"Онлайн-консультация\"><div class=\"rct\">Онлайн-консультация</div><div class=\"rcds\">Видеосвязь, разбор</div></label> <label class=\"rcd\"><input type=\"radio\" name=\"format\" value=\"Индивидуальное онлайн-сопровождение\"><div class=\"rct\">Индивидуальное сопровождение</div><div class=\"rcds\">Программа на 3 месяца</div></label> <label class=\"rcd\"><input type=\"radio\" name=\"format\" value=\"Онлайн-курс «Базовая настройка тела»\"><div class=\"rct\">Онлайн-курс</div><div class=\"rcds\">«Базовая настройка тела»</div></label> <label class=\"rcd\"><input type=\"radio\" name=\"format\" value=\"Онлайн-клуб\"><div class=\"rct\">Онлайн-клуб</div><div class=\"rcds\">Подписка, эфиры, сообщество</div></label> <label class=\"rcd\"><input type=\"radio\" name=\"format\" value=\"Пока не определился\"><div class=\"rct\">Не уверен</div><div class=\"rcds\">Помогите подобрать формат</div></label> </div></div> <div class=\"f\"><label class=\"fl\">Опишите ваш запрос своими словами <span class=\"req\">*</span></label><textarea id=\"request\" name=\"Запрос\" class=\"tall\" placeholder=\"Что именно привело? Что хотите изменить, исправить, понять?\"></textarea><div class=\"fh\">Пишите как чувствуете — важна суть.</div></div> <div class=\"f\"><label class=\"fl\">Откуда вы обо мне узнали?</label><div class=\"cp\"> <label class=\"pl\"><input type=\"checkbox\" data-name=\"src\" value=\"Instagram\"> Instagram</label> <label class=\"pl\"><input type=\"checkbox\" data-name=\"src\" value=\"Telegram\"> Telegram</label> <label class=\"pl\"><input type=\"checkbox\" data-name=\"src\" value=\"YouTube\"> YouTube</label> <label class=\"pl\"><input type=\"checkbox\" data-name=\"src\" value=\"Яндекс.Карты\"> Яндекс.Карты</label> <label class=\"pl\"><input type=\"checkbox\" data-name=\"src\" value=\"По рекомендации\"> По рекомендации</label> <label class=\"pl\"><input type=\"checkbox\" data-name=\"src\" value=\"С сайта\"> С сайта</label> <label class=\"pl\"><input type=\"checkbox\" data-name=\"src\" value=\"Другое\"> Другое</label> </div></div></div> <div class=\"sec\"><div class=\"sh\"><div class=\"sn\">03</div><div class=\"stw\"><div class=\"st\">Карта тела</div><div class=\"ss\">Где живёт ощущение — отметьте на схеме</div></div></div><div class=\"sd\"></div> <div class=\"pmw\"><div class=\"pmt\">— Нажмите на зону, где есть боль или напряжение —</div> <div class=\"bsw\"> <svg class=\"bs\" viewBox=\"0 0 160 380\" xmlns=\"http://www.w3.org/2000/svg\"><text x=\"80\" y=\"14\" class=\"bsl\">Спереди</text> <path class=\"bo\" d=\"M 80,30 C 65,30 60,42 60,52 C 60,62 65,70 65,75 C 60,78 50,82 45,90 L 40,140 C 38,150 35,165 35,180 L 30,210 C 28,220 25,235 25,250 L 22,310 C 20,330 22,365 30,375 M 80,30 C 95,30 100,42 100,52 C 100,62 95,70 95,75 C 100,78 110,82 115,90 L 120,140 C 122,150 125,165 125,180 L 130,210 C 132,220 135,235 135,250 L 138,310 C 140,330 138,365 130,375\"/> <ellipse class=\"bz\" data-zone=\"Шея\" cx=\"80\" cy=\"76\" rx=\"13\" ry=\"10\"/> <ellipse class=\"bz\" data-zone=\"Левое плечо\" cx=\"48\" cy=\"95\" rx=\"12\" ry=\"10\"/> <ellipse class=\"bz\" data-zone=\"Правое плечо\" cx=\"112\" cy=\"95\" rx=\"12\" ry=\"10\"/> <ellipse class=\"bz\" data-zone=\"Грудной отдел\" cx=\"80\" cy=\"125\" rx=\"22\" ry=\"16\"/> <ellipse class=\"bz\" data-zone=\"Живот / диафрагма\" cx=\"80\" cy=\"165\" rx=\"22\" ry=\"14\"/> <ellipse class=\"bz\" data-zone=\"Таз спереди\" cx=\"80\" cy=\"205\" rx=\"24\" ry=\"14\"/> <ellipse class=\"bz\" data-zone=\"Левое бедро\" cx=\"62\" cy=\"245\" rx=\"11\" ry=\"20\"/> <ellipse class=\"bz\" data-zone=\"Правое бедро\" cx=\"98\" cy=\"245\" rx=\"11\" ry=\"20\"/> <ellipse class=\"bz\" data-zone=\"Левое колено\" cx=\"58\" cy=\"290\" rx=\"10\" ry=\"9\"/> <ellipse class=\"bz\" data-zone=\"Правое колено\" cx=\"102\" cy=\"290\" rx=\"10\" ry=\"9\"/> <ellipse class=\"bz\" data-zone=\"Левая голень\" cx=\"55\" cy=\"335\" rx=\"9\" ry=\"18\"/> <ellipse class=\"bz\" data-zone=\"Правая голень\" cx=\"105\" cy=\"335\" rx=\"9\" ry=\"18\"/> <ellipse class=\"bz\" data-zone=\"Левая стопа\" cx=\"50\" cy=\"368\" rx=\"9\" ry=\"6\"/> <ellipse class=\"bz\" data-zone=\"Правая стопа\" cx=\"110\" cy=\"368\" rx=\"9\" ry=\"6\"/> </svg> <svg class=\"bs\" viewBox=\"0 0 160 380\" xmlns=\"http://www.w3.org/2000/svg\"><text x=\"80\" y=\"14\" class=\"bsl\">Сзади</text> <path class=\"bo\" d=\"M 80,30 C 65,30 60,42 60,52 C 60,62 65,70 65,75 C 60,78 50,82 45,90 L 40,140 C 38,150 35,165 35,180 L 30,210 C 28,220 25,235 25,250 L 22,310 C 20,330 22,365 30,375 M 80,30 C 95,30 100,42 100,52 C 100,62 95,70 95,75 C 100,78 110,82 115,90 L 120,140 C 122,150 125,165 125,180 L 130,210 C 132,220 135,235 135,250 L 138,310 C 140,330 138,365 130,375\"/> <ellipse class=\"bz\" data-zone=\"Шея сзади\" cx=\"80\" cy=\"76\" rx=\"13\" ry=\"10\"/> <ellipse class=\"bz\" data-zone=\"Левая лопатка\" cx=\"60\" cy=\"115\" rx=\"14\" ry=\"14\"/> <ellipse class=\"bz\" data-zone=\"Правая лопатка\" cx=\"100\" cy=\"115\" rx=\"14\" ry=\"14\"/> <ellipse class=\"bz\" data-zone=\"Между лопаток\" cx=\"80\" cy=\"120\" rx=\"9\" ry=\"14\"/> <ellipse class=\"bz\" data-zone=\"Грудной отдел сзади\" cx=\"80\" cy=\"155\" rx=\"22\" ry=\"14\"/> <ellipse class=\"bz\" data-zone=\"Поясница\" cx=\"80\" cy=\"195\" rx=\"24\" ry=\"16\"/> <ellipse class=\"bz\" data-zone=\"Крестец\" cx=\"80\" cy=\"230\" rx=\"26\" ry=\"14\"/> <ellipse class=\"bz\" data-zone=\"Задняя поверхность бёдер\" cx=\"80\" cy=\"260\" rx=\"32\" ry=\"10\"/> <ellipse class=\"bz\" data-zone=\"Под коленями\" cx=\"80\" cy=\"295\" rx=\"32\" ry=\"8\"/> <ellipse class=\"bz\" data-zone=\"Икры\" cx=\"80\" cy=\"335\" rx=\"32\" ry=\"14\"/> </svg> </div> <div class=\"pzd\" id=\"pzd\">Отмеченные зоны: <strong>пока нет</strong></div> </div> <div class=\"f\"><label class=\"fl\">Опишите ощущения подробнее</label><textarea id=\"pdesc\" name=\"Описание_боли\" class=\"tall\" placeholder=\"Характер (тянет, стреляет, ноет). Когда сильнее? Что облегчает? Как давно?\"></textarea></div> <div class=\"f\"><label class=\"fl\">Интенсивность ощущений в худшие моменты</label><div class=\"rw\"><div class=\"rr\"><input type=\"range\" id=\"pl\" name=\"Боль_уровень\" min=\"0\" max=\"10\" value=\"0\"><div class=\"rv\" id=\"plv\">0</div></div><div class=\"rl\"><span>0 — нет</span><span>5 — мешает</span><span>10 — невыносимо</span></div></div></div></div> <div class=\"sec\"><div class=\"sh\"><div class=\"sn\">04</div><div class=\"stw\"><div class=\"st\">История тела</div><div class=\"ss\">Травмы, операции, хроника</div></div></div><div class=\"sd\"></div> <div class=\"f\"><label class=\"fl\">Перенесённые травмы (даже давние) <span class=\"req\">*</span></label><textarea id=\"inj\" name=\"Травмы\" placeholder=\"Переломы, вывихи, растяжения, ДТП, спортивные травмы. Если ничего не было — «нет».\"></textarea></div> <div class=\"f\"><label class=\"fl\">Операции (любые) <span class=\"req\">*</span></label><textarea id=\"surg\" name=\"Операции\" placeholder=\"Какие, когда, как восстанавливались. Если не было — «нет».\"></textarea></div> <div class=\"f\"><label class=\"fl\">Хронические заболевания и диагнозы</label><textarea id=\"chr\" name=\"Хроника\" placeholder=\"Грыжи, протрузии, сколиоз, сердечно-сосудистые, эндокринные — всё, что важно.\"></textarea><div class=\"fh\">Конфиденциально, для безопасной работы.</div></div> <div class=\"f\"><label class=\"fl\">Регулярный приём лекарств</label><textarea id=\"med\" name=\"Лекарства\" placeholder=\"Какие препараты принимаете на постоянной основе.\"></textarea></div> <div class=\"f\"><label class=\"fl\">Особые состояния</label><div class=\"cp\"> <label class=\"pl\"><input type=\"checkbox\" data-name=\"spec\" value=\"Беременность\"> Беременность</label> <label class=\"pl\"><input type=\"checkbox\" data-name=\"spec\" value=\"Послеродовой период\"> Послеродовой период</label> <label class=\"pl\"><input type=\"checkbox\" data-name=\"spec\" value=\"После операции\"> После операции</label> <label class=\"pl\"><input type=\"checkbox\" data-name=\"spec\" value=\"Скачки давления\"> Скачки давления</label> <label class=\"pl\"><input type=\"checkbox\" data-name=\"spec\" value=\"Аллергии\"> Аллергии</label> <label class=\"pl\"><input type=\"checkbox\" data-name=\"spec\" value=\"Ничего из этого\"> Ничего из этого</label> </div></div> <div class=\"f\"><label class=\"fl\">Разрешение врача на физическую нагрузку?</label><div class=\"cp\"> <label class=\"pl\"><input type=\"radio\" name=\"da\" value=\"Да, есть разрешение\"> Да, есть</label> <label class=\"pl\"><input type=\"radio\" name=\"da\" value=\"Не требуется\"> Не требуется</label> <label class=\"pl\"><input type=\"radio\" name=\"da\" value=\"Проконсультируюсь\"> Проконсультируюсь</label> <label class=\"pl\"><input type=\"radio\" name=\"da\" value=\"Не знаю\"> Не знаю</label> </div></div></div> <div class=\"sec\"><div class=\"sh\"><div class=\"sn\">05</div><div class=\"stw\"><div class=\"st\">Что уже пробовали</div><div class=\"ss\">Какие подходы дали результат, а какие нет</div></div></div><div class=\"sd\"></div> <div class=\"f\"><label class=\"fl\">Какими методами пробовали решать вопрос?</label><div class=\"cp\"> <label class=\"pl\"><input type=\"checkbox\" data-name=\"tr\" value=\"Массаж\"> Массаж</label> <label class=\"pl\"><input type=\"checkbox\" data-name=\"tr\" value=\"Остеопат\"> Остеопат</label> <label class=\"pl\"><input type=\"checkbox\" data-name=\"tr\" value=\"Мануальный терапевт\"> Мануальный терапевт</label> <label class=\"pl\"><input type=\"checkbox\" data-name=\"tr\" value=\"Тренажёрный зал\"> Тренажёрный зал</label> <label class=\"pl\"><input type=\"checkbox\" data-name=\"tr\" value=\"Йога\"> Йога</label> <label class=\"pl\"><input type=\"checkbox\" data-name=\"tr\" value=\"Пилатес\"> Пилатес</label> <label class=\"pl\"><input type=\"checkbox\" data-name=\"tr\" value=\"Стретчинг\"> Стретчинг</label> <label class=\"pl\"><input type=\"checkbox\" data-name=\"tr\" value=\"ЛФК\"> ЛФК</label> <label class=\"pl\"><input type=\"checkbox\" data-name=\"tr\" value=\"Иглоукалывание\"> Иглоукалывание</label> <label class=\"pl\"><input type=\"checkbox\" data-name=\"tr\" value=\"Физиотерапия\"> Физиотерапия</label> <label class=\"pl\"><input type=\"checkbox\" data-name=\"tr\" value=\"Блокады\"> Блокады, уколы</label> <label class=\"pl\"><input type=\"checkbox\" data-name=\"tr\" value=\"Онлайн-курсы\"> Онлайн-курсы</label> <label class=\"pl\"><input type=\"checkbox\" data-name=\"tr\" value=\"Системно ничего\"> Системно ничего</label> </div></div> <div class=\"f\"><label class=\"fl\">Что давало результат, а что нет?</label><textarea id=\"trd\" name=\"Что_работало\" class=\"tall\" placeholder=\"Что помогало временно? Что не сработало? Что усугубляло?\"></textarea></div> <div class=\"f\"><label class=\"fl\">Сколько вкладывали в решение этого вопроса в год?</label><div class=\"cp\"> <label class=\"pl\"><input type=\"radio\" name=\"ps\" value=\"До 30 000 ₽\"> До 30 000 ₽</label> <label class=\"pl\"><input type=\"radio\" name=\"ps\" value=\"30–100 000 ₽\"> 30–100 000 ₽</label> <label class=\"pl\"><input type=\"radio\" name=\"ps\" value=\"100–300 000 ₽\"> 100–300 000 ₽</label> <label class=\"pl\"><input type=\"radio\" name=\"ps\" value=\"Более 300 000 ₽\"> Более 300 000 ₽</label> <label class=\"pl\"><input type=\"radio\" name=\"ps\" value=\"Не считал\"> Не считал</label> </div></div></div> <div class=\"sec\"><div class=\"sh\"><div class=\"sn\">06</div><div class=\"stw\"><div class=\"st\">Тело сейчас</div><div class=\"ss\">Дыхание, осанка, движение</div></div></div><div class=\"sd\"></div> <div class=\"f\"><label class=\"fl\">Как вы дышите большую часть дня?</label><div class=\"cp\"> <label class=\"pl\"><input type=\"radio\" name=\"br\" value=\"Носом, спокойно\"> Носом, спокойно</label> <label class=\"pl\"><input type=\"radio\" name=\"br\" value=\"Носом, поверхностно\"> Носом, поверхностно</label> <label class=\"pl\"><input type=\"radio\" name=\"br\" value=\"Часто ртом\"> Часто ртом</label> <label class=\"pl\"><input type=\"radio\" name=\"br\" value=\"Не задумывался\"> Не задумывался</label> </div></div> <div class=\"f\"><label class=\"fl\">Что вы знаете о своей осанке?</label><textarea id=\"post\" name=\"Осанка\" placeholder=\"Сутулость, асимметрия, наклон таза. Можете прислать фото в чат позже.\"></textarea></div> <div class=\"f\"><label class=\"fl\">Стопы и обувь</label><div class=\"cp\"> <label class=\"pl\"><input type=\"checkbox\" data-name=\"ft\" value=\"Плоскостопие\"> Плоскостопие</label> <label class=\"pl\"><input type=\"checkbox\" data-name=\"ft\" value=\"Высокий свод\"> Высокий свод</label> <label class=\"pl\"><input type=\"checkbox\" data-name=\"ft\" value=\"Косточки\"> Косточки</label> <label class=\"pl\"><input type=\"checkbox\" data-name=\"ft\" value=\"Обувь стирается неравномерно\"> Обувь неравномерно</label> <label class=\"pl\"><input type=\"checkbox\" data-name=\"ft\" value=\"Ортопедические стельки\"> Ортопедические стельки</label> <label class=\"pl\"><input type=\"checkbox\" data-name=\"ft\" value=\"Каблук ежедневно\"> Каблук ежедневно</label> <label class=\"pl\"><input type=\"checkbox\" data-name=\"ft\" value=\"Всё в норме\"> Всё в норме</label> </div></div> <div class=\"f\"><label class=\"fl\">Какая физическая активность сейчас? <span class=\"req\">*</span></label><textarea id=\"act\" name=\"Активность\" placeholder=\"Зал, бег, бассейн, теннис, йога — что и как часто.\"></textarea></div> <div class=\"f\"><label class=\"fl\">Сколько часов в день проводите сидя?</label><div class=\"cp\"> <label class=\"pl\"><input type=\"radio\" name=\"sit\" value=\"Менее 4\"> Менее 4 ч</label> <label class=\"pl\"><input type=\"radio\" name=\"sit\" value=\"4–6\"> 4–6 ч</label> <label class=\"pl\"><input type=\"radio\" name=\"sit\" value=\"6–9\"> 6–9 ч</label> <label class=\"pl\"><input type=\"radio\" name=\"sit\" value=\"9+\"> 9+ ч</label> </div></div> <div class=\"f\"><label class=\"fl\">Род деятельности (профессия)</label><input type=\"text\" id=\"prof\" name=\"Профессия\" placeholder=\"IT / врач / финансы / фрилансер\"></div></div> <div class=\"sec\"><div class=\"sh\"><div class=\"sn\">07</div><div class=\"stw\"><div class=\"st\">Образ жизни</div><div class=\"ss\">Сон, питание, вода, восстановление</div></div></div><div class=\"sd\"></div> <div class=\"f\"><label class=\"fl\">Как вы спите?</label><div clas