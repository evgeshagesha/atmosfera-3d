\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"> <g stroke=\"none\" stroke-width=\"2px\" fill=\"none\" fill-rule=\"evenodd\" stroke-linecap=\"square\"> <g transform=\"translate(1.000000, 1.000000)\" stroke=\"#ffffff\"> <path d=\"M0,11 L22,11\"></path> <path d=\"M11,0 L11,22\"></path> </g> </g> </svg> </span> <span class=\"t668__circle\" style=\"background-color: #4766ff\"></span> </span> <span class=\"t668__icon t668__icon-hover\"> <span class=\"t668__lines\"> <svg role=\"presentation\" focusable=\"false\" width=\"24px\" height=\"24px\" viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"> <g stroke=\"none\" stroke-width=\"2px\" fill=\"none\" fill-rule=\"evenodd\" stroke-linecap=\"square\"> <g transform=\"translate(1.000000, 1.000000)\" stroke=\"#ffffff\"> <path d=\"M0,11 L22,11\"></path> <path d=\"M11,0 L11,22\"></path> </g> </g> </svg> </span> <span class=\"t668__circle\" style=\"background-color: #1a40fc\"></span> </span> </button> </div> <div class=\"t668__content\"\nid=\"accordion2_1146425806\"\nhidden > <div class=\"t668__textwrapper\"> <div class=\"t668__text t-descr t-descr_xs\" field=\"li_descr__3437175427191\" style=\"color: #2c2b2b;\">Один платеж, <br />через платежную систему</div> </div> </div> </div> </div> </div> <div class=\"t668__col t-col t-col_12 \" style=\"margin-bottom:5px;\"> <div class=\"t668__accordion\" data-accordion=\"false\" data-scroll-to-expanded=\"false\"> <div class=\"t668__wrapper\" style=\"background-color: #fcfcfc;\"> <div class=\"t668__header \"> <button type=\"button\"\nclass=\"t668__trigger-button\"\naria-controls=\"accordion3_1146425806\"\naria-expanded=\"false\"> <span class=\"t668__title t-name t-name_xl\" field=\"li_title__1751718510589\" style=\"color: #2c2b2b;\">Могу ли я вернуть деньги?</span> <span class=\"t668__icon\"> <span class=\"t668__lines\"> <svg role=\"presentation\" focusable=\"false\" width=\"24px\" height=\"24px\" viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"> <g stroke=\"none\" stroke-width=\"2px\" fill=\"none\" fill-rule=\"evenodd\" stroke-linecap=\"square\"> <g transform=\"translate(1.000000, 1.000000)\" stroke=\"#ffffff\"> <path d=\"M0,11 L22,11\"></path> <path d=\"M11,0 L11,22\"></path> </g> </g> </svg> </span> <span class=\"t668__circle\" style=\"background-color: #4766ff\"></span> </span> <span class=\"t668__icon t668__icon-hover\"> <span class=\"t668__lines\"> <svg role=\"presentation\" focusable=\"false\" width=\"24px\" height=\"24px\" viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"> <g stroke=\"none\" stroke-width=\"2px\" fill=\"none\" fill-rule=\"evenodd\" stroke-linecap=\"square\"> <g transform=\"translate(1.000000, 1.000000)\" stroke=\"#ffffff\"> <path d=\"M0,11 L22,11\"></path> <path d=\"M11,0 L11,22\"></path> </g> </g> </svg> </span> <span class=\"t668__circle\" style=\"background-color: #1a40fc\"></span> </span> </button> </div> <div class=\"t668__content\"\nid=\"accordion3_1146425806\"\nhidden > <div class=\"t668__textwrapper\"> <div class=\"t668__text t-descr t-descr_xs\" field=\"li_descr__1751718510589\" style=\"color: #2c2b2b;\">Да, в течение недели, если вам что-то не понравится, я верну вам деньги</div> </div> </div> </div> </div> </div> <div class=\"t668__col t-col t-col_12 \" style=\"margin-bottom:5px;\"> <div class=\"t668__accordion\" data-accordion=\"false\" data-scroll-to-expanded=\"false\"> <div class=\"t668__wrapper\" style=\"background-color: #fcfcfc;\"> <div class=\"t668__header \"> <button type=\"button\"\nclass=\"t668__trigger-button\"\naria-controls=\"accordion4_1146425806\"\naria-expanded=\"false\"> <span class=\"t668__title t-name t-name_xl\" field=\"li_title__1751718540938\" style=\"color: #2c2b2b;\">Под какие цели подойдет клуб?</span> <span class=\"t668__icon\"> <span class=\"t668__lines\"> <svg role=\"presentation\" focusable=\"false\" width=\"24px\" height=\"24px\" viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"> <g stroke=\"none\" stroke-width=\"2px\" fill=\"none\" fill-rule=\"evenodd\" stroke-linecap=\"square\"> <g transform=\"translate(1.000000, 1.000000)\" stroke=\"#ffffff\"> <path d=\"M0,11 L22,11\"></path> <path d=\"M11,0 L11,22\"></path> </g> </g> </svg> </span> <span class=\"t668__circle\" style=\"background-color: #4766ff\"></span> </span> <span class=\"t668__icon t668__icon-hover\"> <span class=\"t668__lines\"> <svg role=\"presentation\" focusable=\"false\" width=\"24px\" height=\"24px\" viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"> <g stroke=\"none\" stroke-width=\"2px\" fill=\"none\" fill-rule=\"evenodd\" stroke-linecap=\"square\"> <g transform=\"translate(1.000000, 1.000000)\" stroke=\"#ffffff\"> <path d=\"M0,11 L22,11\"></path> <path d=\"M11,0 L11,22\"></path> </g> </g> </svg> </span> <span class=\"t668__circle\" style=\"background-color: #1a40fc\"></span> </span> </button> </div> <div class=\"t668__content\"\nid=\"accordion4_1146425806\"\nhidden > <div class=\"t668__textwrapper\"> <div class=\"t668__text t-descr t-descr_xs\" field=\"li_descr__1751718540938\" style=\"color: #2c2b2b;\">Клуб подойдёт тем, кто хочет избавиться от боли, восстановиться, стать сильнее и выносливее, улучшить осанку, питание и обрести здоровое, гибкое тело. Комплексный подход ко всему телу</div> </div> </div> </div> </div> </div> <div class=\"t668__col t-col t-col_12 \" style=\"margin-bottom:5px;\"> <div class=\"t668__accordion\" data-accordion=\"false\" data-scroll-to-expanded=\"false\"> <div class=\"t668__wrapper\" style=\"background-color: #fcfcfc;\"> <div class=\"t668__header \"> <button type=\"button\"\nclass=\"t668__trigger-button\"\naria-controls=\"accordion5_1146425806\"\naria-expanded=\"false\"> <span class=\"t668__title t-name t-name_xl\" field=\"li_title__1751718595217\" style=\"color: #2c2b2b;\">Сколько будет доступен клуб?</span> <span class=\"t668__icon\"> <span class=\"t668__lines\"> <svg role=\"presentation\" focusable=\"false\" width=\"24px\" height=\"24px\" viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"> <g stroke=\"none\" stroke-width=\"2px\" fill=\"none\" fill-rule=\"evenodd\" stroke-linecap=\"square\"> <g transform=\"translate(1.000000, 1.000000)\" stroke=\"#ffffff\"> <path d=\"M0,11 L22,11\"></path> <path d=\"M11,0 L11,22\"></path> </g> </g> </svg> </span> <span class=\"t668__circle\" style=\"background-color: #4766ff\"></span> </span> <span class=\"t668__icon t668__icon-hover\"> <span class=\"t668__lines\"> <svg role=\"presentation\" focusable=\"false\" width=\"24px\" height=\"24px\" viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"> <g stroke=\"none\" stroke-width=\"2px\" fill=\"none\" fill-rule=\"evenodd\" stroke-linecap=\"square\"> <g transform=\"translate(1.000000, 1.000000)\" stroke=\"#ffffff\"> <path d=\"M0,11 L22,11\"></path> <path d=\"M11,0 L11,22\"></path> </g> </g> </svg> </span> <span class=\"t668__circle\" style=\"background-color: #1a40fc\"></span> </span> </button> </div> <div class=\"t668__content\"\nid=\"accordion5_1146425806\"\nhidden > <div class=\"t668__textwrapper\"> <div class=\"t668__text t-descr t-descr_xs\" field=\"li_descr__1751718595217\" style=\"color: #2c2b2b;\">На данный момент, доступ навсегда,для всех кто успел зайти по данному тарифу<br /><br /></div> </div> </div> </div> </div> </div> <div class=\"t668__col t-col t-col_12 \" style=\"margin-bottom:5px;\"> <div class=\"t668__accordion\" data-accordion=\"false\" data-scroll-to-expanded=\"false\"> <div class=\"t668__wrapper\" style=\"background-color: #fcfcfc;\"> <div class=\"t668__header \"> <button type=\"button\"\nclass=\"t668__trigger-button\"\naria-controls=\"accordion6_1146425806\"\naria-expanded=\"false\"> <span class=\"t668__title t-name t-name_xl\" field=\"li_title__175